{
  "name": "decision-board-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:firebase": "node scripts/verify-firebase-config.mjs && npm run build",
    "preview": "vite preview",
    "test:rules": "node --test tests/firebase-rules.test.mjs",
    "test:rules:emulator": "node scripts/run-rules-tests.mjs",
    "test:gemini-worker": "node --test tests/gemini-worker.test.mjs",
    "test:geometry": "node --test tests/mind-map-geometry.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm run build && npm run test:sites && npm run test:geometry && npm run test:gemini-worker && npm audit --omit=dev",
    "deploy:check": "node scripts/verify-firebase-config.mjs && npm run check && npm run test:rules:emulator",
    "deploy:firebase": "npm run deploy:check && npx --yes firebase-tools@15.24.0 deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^12.16.0",
    "html-to-image": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.4.3"
  }
}
