# Firebase Console > Project settings > Your apps > Web app
# Keep this explicit so a production mistake cannot silently use Demo mode.
VITE_APP_MODE=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL returned after deploying app/gemini-worker.
# Never put the Gemini API key in this or any VITE_* variable.
VITE_GEMINI_PROXY_URL=

# Only set this to true while running the local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
